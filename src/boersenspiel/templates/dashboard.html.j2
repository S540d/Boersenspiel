{% extends "base.html.j2" %}
{% block content %}
  <section class="strategy" id="einleitung">
    <h2 data-i18n-en="What this is about">Worum es hier geht</h2>
    <p class="hint" data-i18n-en="Investment strategies are hard to compare as long as you talk about them instead of computing them. This dashboard simulates several strategies and stock-market adages on the same real price history: same instruments, same rules for fees and taxes, same periods. What is left is the difference made by the strategy itself.">
      Anlagestrategien lassen sich schlecht vergleichen, solange man über sie
      redet statt sie zu rechnen. Dieses Dashboard simuliert mehrere Strategien
      und Börsenweisheiten auf derselben echten Kurshistorie: gleiche
      Instrumente, gleiche Regeln für Gebühren und Steuern, gleiche Zeiträume.
      Übrig bleibt der Unterschied, den die Strategie selbst macht.
    </p>
    <p class="hint" data-i18n-en="The basic idea: every strategy splits the capital across at least two buckets - bucket A for safety (bonds, money market, gold) and bucket B for growth (equity ETFs, Bitcoin). That is the barbell: mostly clearly safe or clearly risky, little in between. Whenever a bucket drifts too far from its target weight, the portfolio is shifted back.">
      <strong>Die Grundidee:</strong> Jede Strategie verteilt das Kapital auf
      mindestens zwei Töpfe &ndash; <strong>Topf A</strong> für die Sicherheit
      (Anleihen, Geldmarkt, Gold) und <strong>Topf B</strong> für das Wachstum
      (Aktien-ETFs, Bitcoin). Genau das ist das Barbell: überwiegend deutlich
      sicher oder deutlich riskant, wenig dazwischen. Driftet ein Topf zu weit
      von seinem Zielgewicht weg, wird zurückgeschichtet.
    </p>
    <p class="hint" data-i18n-en="It is a virtual portfolio for learning purposes, not investment advice: everything is recomputed from the stored price history on every build, nothing is written down by hand. Which instruments are involved, all metrics in one table, and above all which assumptions the numbers rest on, are behind the three-dot menu at the top right.">
      Es ist ein virtuelles Depot zu Lernzwecken, keine Anlageberatung: alles
      wird bei jedem Build neu aus der gespeicherten Kurshistorie gerechnet,
      nichts von Hand eingetragen. Welche Instrumente dahinterstecken, alle
      Kennzahlen in einer Tabelle und vor allem, auf welchen Annahmen die
      Zahlen beruhen, steht im Drei-Punkt-Menü oben rechts.
    </p>
    {# Der Link steht bewusst in einem eigenen Element: der Sprachumschalter
       ersetzt den textContent eines uebersetzten Absatzes komplett, ein darin
       eingebettetes <a> waere auf Englisch verschwunden. #}
    <p class="detail-link"><a href="praemissen.html" data-i18n-en="Premises &amp; assumptions: what the numbers are based on &rarr;">Prämissen &amp; Annahmen: worauf die Zahlen beruhen &rarr;</a></p>
  </section>
{% if learnings %}
  <section class="strategy" id="key-learnings">
    <h2>Key Learnings</h2>
    <p class="hint" data-i18n-en="Derived freshly from the simulation results on every build - not stored text. If the price history changes, these statements change with it.">
      Bei jedem Build neu aus den Simulationsergebnissen abgeleitet – nicht
      hinterlegter Text. Ändert sich die Kurshistorie, ändern sich diese Aussagen mit.
    </p>
    <ol class="learnings">
    {% for l in learnings %}
      <li>
        <h3 data-i18n-en="{{ l.titel_en }}">{{ l.titel_de }}</h3>
        <p class="kernaussage" data-i18n-en="{{ l.kernaussage_en }}">{{ l.kernaussage_de }}</p>
        <p class="detail" data-i18n-en="{{ l.detail_en }}">{{ l.detail_de }}</p>
      </li>
    {% endfor %}
    </ol>
  </section>
{% endif %}
  <section class="strategy" id="uebersicht">
    <h2 data-i18n-en="Return comparison">Rendite im Vergleich</h2>
    <p class="hint" data-i18n-en="Annualized return (CAGR) of the main strategies and scenarios{% if vergleich_verfuegbar %}, over the common comparison period from {{ vergleich_beginn }} so the bars are actually comparable{% endif %}. Gross, before tax. The market-sayings scenarios have their own chart below; every run, including volatility, max drawdown, Sharpe and Sortino, is in the full table."data-erweitert="Annualisierte Rendite (CAGR) der wichtigsten Strategien und Szenarien, über den verlängerten Auswertezeitraum ab {{ erweitert_beginn }}. Brutto, vor Steuer. Die Börsenweisheiten-Szenarien haben weiter unten einen eigenen Chart; alle Läufe samt Volatilität, Max Drawdown, Sharpe und Sortino stehen in der vollständigen Tabelle." data-i18n-en-erweitert="Annualized return (CAGR) of the main strategies and scenarios, over the extended evaluation period from {{ erweitert_beginn }}. Gross, before tax. The market-sayings scenarios have their own chart below; every run, including volatility, max drawdown, Sharpe and Sortino, is in the full table.">
      Annualisierte Rendite (CAGR) der wichtigsten Strategien und
      Szenarien{% if vergleich_verfuegbar %}, über den gemeinsamen
      Vergleichszeitraum ab {{ vergleich_beginn }}, damit die Balken überhaupt
      vergleichbar sind{% endif %}. Brutto, vor Steuer. Die
      Börsenweisheiten-Szenarien haben weiter unten einen eigenen Chart; alle
      Läufe samt Volatilität, Max Drawdown, Sharpe und Sortino stehen in der
      vollständigen Tabelle.
    </p>
{% if erweitert_verfuegbar %}
    <p class="hint" data-erweitert-nur hidden data-i18n-en="Extended evaluation period is on: all figures run over {{ erweitert_beginn }} to {{ erweitert_ende }} and rest on the assumption about missing prices described in the premises. Switch it off in the three-dot menu.">
      <strong>Verlängerter Auswertezeitraum ist an:</strong> Alle Zahlen laufen
      über {{ erweitert_beginn }} bis {{ erweitert_ende }} und beruhen auf der
      in den Prämissen beschriebenen Annahme zu fehlenden Kursen. Ausschalten
      im Drei-Punkt-Menü.
    </p>
{% endif %}
    <div class="summary-chart-box"><canvas id="summary-chart"></canvas></div>
    <p class="detail-link"><a href="vergleich.html" data-i18n-en="All metrics compared &rarr;">Alle Kennzahlen im Vergleich &rarr;</a></p>
  </section>
{% if benchmark_optionen %}
  <div class="benchmark-switch" id="benchmark-switch">
    <span data-i18n-en="Show a benchmark in the value-history charts:">Benchmark in den Wertverlauf-Charts einblenden:</span>
    <button type="button" data-benchmark="none" class="active" data-i18n-en="No benchmark">Kein Benchmark</button>
    {% for b in benchmark_optionen %}
    <button type="button" data-benchmark="{{ b.id }}">{{ b.label }}</button>
    {% endfor %}
  </div>
{% endif %}
{% for gruppe in teilszenario_gruppen %}
  <section class="strategy" id="gruppe-{{ gruppe.id }}">
    <h2><span data-i18n-en="{{ gruppe.name }} compared">{{ gruppe.name }} im Vergleich</span></h2>
    <p class="hint" data-i18n-en="The thick line is the combination of all {{ gruppe.mitglieder|length - 1 }} rules, the thin ones are the same rules on their own. The combination follows no single rule: each rule proposes an equity quota per week, and what gets traded is the average of those proposals. So two rules that contradict each other partly cancel out instead of one of them winning. That makes it readable whether throwing the rules together beats each rule by itself.">
      Die dicke Linie ist die Kombination aus allen
      {{ gruppe.mitglieder|length - 1 }} Regeln, die dünnen sind dieselben
      Regeln einzeln. Die Kombination folgt keiner Regel allein: jede Regel
      schlägt pro Woche eine Aktienquote vor, gehandelt wird der Mittelwert
      dieser Vorschläge. Zwei Regeln, die sich widersprechen, heben sich damit
      teilweise auf, statt dass eine gewinnt. So lässt sich ablesen, ob das
      Zusammenwerfen mehr bringt als jede Regel für sich.
    </p>
    <p class="detail-link"><a href="praemissen.html#kombination" data-i18n-en="How the combination is computed &rarr;">Wie die Kombination genau rechnet &rarr;</a></p>
    <div class="chart-box-large"><canvas id="gruppen-chart-{{ loop.index }}"></canvas></div>
  </section>
{% endfor %}
{% for s in strategies %}
  <section class="strategy" id="{{ s.id }}">
    <h2>{{ s.name }}</h2>
    {% if s.beschreibung %}<p class="hint" data-i18n-en="{{ s.beschreibung_en }}">{{ s.beschreibung }}</p>{% endif %}
    {% if s.zeitraum_presets %}
    <div class="zeitraum-switch" id="zeitraum-switch-{{ loop.index }}">
      {% for p in s.zeitraum_presets %}
      <button type="button" data-preset="{{ p.id }}"{% if p.id == 'alle' %} class="active"{% endif %} data-i18n-en="{{ p.label_en }}">{{ p.label }}</button>
      {% endfor %}
      <span class="zeitraum-rendite"></span>
    </div>
    {% endif %}
    <div class="chart-box-large"><canvas id="value-chart-{{ loop.index }}"></canvas></div>
    <p class="detail-link"><a href="{{ s.id }}.html" data-i18n-en="View details (metrics, bucket weighting, instruments) &rarr;">Details ansehen (Kennzahlen, Topf-Gewichtung, Instrumente) &rarr;</a></p>
  </section>
{% endfor %}
{% endblock %}
{% block scripts %}
<script>
  const style = getComputedStyle(document.documentElement);
  const cssVar = (name) => style.getPropertyValue(name).trim();
  const colors = {
    series1: cssVar('--series-1'),
    series2: cssVar('--series-2'),
    series3: cssVar('--series-3'),
    series4: cssVar('--series-4'),
    series5: cssVar('--series-5'),
    series6: cssVar('--series-6'),
    series7: cssVar('--series-7'),
    grid: cssVar('--grid'),
    axis: cssVar('--axis'),
    text: cssVar('--text-secondary'),
  };
  const commonScales = {
    x: { grid: { color: colors.grid }, ticks: { color: colors.text, maxTicksLimit: 8 } },
    y: { grid: { color: colors.grid }, ticks: { color: colors.text }, border: { color: colors.axis } },
  };
  // Sprachumschalter (Dreipunktmenue): Chart.js-Texte (Titel, Achsen, Legenden) sind
  // beim Erzeugen des Charts fixe Strings, keine DOM-Knoten - data-i18n-en greift hier
  // nicht. T() liest die aktuelle Sprache aus <html lang>, chartRefreshers haelt fuer
  // jeden Chart eine Funktion, die seine uebersetzbaren Texte neu setzt; base.html.j2
  // ruft beim Umschalten alle window.__i18nRefresh-Funktionen auf.
  function T(de, en) { return document.documentElement.lang === 'en' ? en : de; }
  const chartRefreshers = [];
  window.__i18nRefresh.push(function () { chartRefreshers.forEach(function (fn) { fn(); }); });

  // Gemeinsames Maximum ueber alle Wertverlauf-Charts (#24), damit unterschiedliche
  // Strategien optisch vergleichbar bleiben statt jeweils unabhaengig zu skalieren.
  const wertChartMax = {{ wert_chart_max | tojson }};
  const wertChartScales = {
    x: commonScales.x,
    y: { ...commonScales.y, min: 0, suggestedMax: wertChartMax * 1.05 },
  };

  {
    const summaryChart = new Chart(document.getElementById('summary-chart'), {
      type: 'bar',
      data: {
        labels: {{ chart_summary | map(attribute='name') | list | tojson }},
        datasets: [{
          label: 'CAGR % p.a.',
          {% if vergleich_verfuegbar %}
          data: {{ chart_summary | map(attribute='vergleich_cagr_pct') | list | tojson }},
          backgroundColor: {{ chart_summary | map(attribute='vergleich_cagr_pct') | list | tojson }}.map((v) => v >= 0 ? colors.series3 : colors.series2),
          {% else %}
          data: {{ chart_summary | map(attribute='cagr_pct') | list | tojson }},
          backgroundColor: {{ chart_summary | map(attribute='cagr_pct') | list | tojson }}.map((v) => v >= 0 ? colors.series3 : colors.series2),
          {% endif %}
        }],
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, title: { display: true, text: '', color: colors.text } },
        scales: {
          x: { grid: { color: colors.grid }, ticks: { color: colors.text }, border: { color: colors.axis } },
          // autoSkip aus (#92): Chart.js liess sonst Beschriftungen weg, sobald
          // die Balken eng standen - es gab mehr Balken als Namen.
          y: { grid: { color: colors.grid }, ticks: { color: colors.text, autoSkip: false }, border: { color: colors.axis } },
        },
      },
    });
{% if erweitert_verfuegbar %}
    // #91: dieselben Balken aus dem verlaengerten Auswertezeitraum.
    const summaryEigen = summaryChart.data.datasets[0].data.slice();
    const summaryErweitert = [
      {% for s in chart_summary %}
      {{ (s.erweitert.cagr_pct if s.erweitert else (s.vergleich_cagr_pct if vergleich_verfuegbar else s.cagr_pct)) | tojson }},
      {% endfor %}
    ];
    const summaryLabelsEigen = summaryChart.data.labels.slice();
    window.__erweitertRefresh.push(function (erweitert) {
      // Die Balken sind nach der CAGR des Standard-Zeitraums sortiert - im
      // verlaengerten Zeitraum gilt eine andere Reihenfolge.
      let labels = summaryLabelsEigen;
      let daten = summaryEigen;
      if (erweitert) {
        const paare = summaryLabelsEigen
          .map((label, i) => ({ label, wert: summaryErweitert[i] }))
          .sort((a, b) => b.wert - a.wert);
        labels = paare.map((pk) => pk.label);
        daten = paare.map((pk) => pk.wert);
      }
      summaryChart.data.labels = labels;
      summaryChart.data.datasets[0].data = daten;
      summaryChart.data.datasets[0].backgroundColor = daten.map((v) => v >= 0 ? colors.series3 : colors.series2);
      summaryChart.options.plugins.title.text = erweitert
        ? T('Annualisierte Rendite (CAGR, % p.a.) im verlängerten Auswertezeitraum ab {{ erweitert_beginn }}', 'Annualized return (CAGR, % p.a.) over the extended evaluation period from {{ erweitert_beginn }}')
        : summaryTitelEigen();
      summaryChart.update();
    });
{% endif %}
    function summaryTitelEigen() {
      return {% if vergleich_verfuegbar %}
        T('Annualisierte Rendite (CAGR, % p.a.) im gemeinsamen Vergleichszeitraum ab {{ vergleich_beginn }}', 'Annualized return (CAGR, % p.a.) over the common comparison period starting {{ vergleich_beginn }}')
      {% else %}
        T('Annualisierte Rendite (CAGR, % p.a.)', 'Annualized return (CAGR, % p.a.)')
      {% endif %};
    }
    chartRefreshers.push(function () {
      summaryChart.options.plugins.title.text = summaryTitelEigen();
      summaryChart.update();
    });
    chartRefreshers[chartRefreshers.length - 1]();
  }

  // Benchmark-Overlay-Schalter (#72): EIN zentraler Schalter fuer alle
  // szenariospezifischen Wertverlauf-Charts auf dieser Seite statt eines
  // Schalters je Chart. `chart.__benchmarks` haelt die fuer den jeweils
  // AKTUELL angezeigten Zeitraum passenden Kandidaten (siehe initZeitraumSwitch
  // unten, das dieses Feld beim Preset-Wechsel neu setzt); die Auswahl selbst
  // (`currentBenchmarkId`) ist global, weil ein einzelner Schalter alle Charts
  // steuert. Wichtig (Owner-Vorgabe #72): die Y-Achse bleibt dabei unveraendert
  // - deshalb ein fixes `max` statt `suggestedMax` auf allen betroffenen Charts
  // (siehe unten): eine Benchmark-Linie, die ueber das bisherige Maximum
  // hinausschiesst, wird vom Chart einfach oben abgeschnitten statt die Skala
  // zu strecken.
  let currentBenchmarkId = 'none';
  const benchmarkCharts = [];

  function applyBenchmarkDataset(chart) {
    // Der Gruppen-Chart (#93) bringt mehrere eigene Linien mit - die
    // Benchmark-Linie haengt sich deshalb hinter __baseDatasetCount an, statt
    // fest auf Position 1 zu schreiben und dort ein Mitglied zu ueberschreiben.
    const basis = chart.__baseDatasetCount || 1;
    const kandidaten = chart.__benchmarks || [];
    const bench = kandidaten.find((b) => b.id === currentBenchmarkId);
    if (bench) {
      chart.data.datasets[basis] = {
        label: bench.label,
        data: bench.total_values,
        borderColor: colors.series4,
        backgroundColor: colors.series4,
        borderWidth: 1.5,
        borderDash: [6, 4],
        pointRadius: 0,
        tension: 0.15,
      };
    } else {
      chart.data.datasets.length = basis;
    }
    chart.update();
  }

  const benchmarkSwitchEl = document.getElementById('benchmark-switch');
  if (benchmarkSwitchEl) {
    benchmarkSwitchEl.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentBenchmarkId = btn.dataset.benchmark;
        benchmarkSwitchEl.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
        benchmarkCharts.forEach(applyBenchmarkDataset);
      });
    });
  }

  const gruppenSeriesColors = [
    colors.series1, colors.series2, colors.series3,
    colors.series5, colors.series6, colors.series7,
  ];

  {% for gruppe in teilszenario_gruppen %}
  {
    const gruppenChart{{ loop.index }} = new Chart(document.getElementById('gruppen-chart-{{ loop.index }}'), {
      type: 'line',
      data: {
        labels: {{ gruppe.mitglieder[0].labels_json | safe }},
        datasets: [
          {% for m in gruppe.mitglieder %}
          {
            label: {{ m.name | tojson }},
            data: {{ m.total_values_json | safe }},
            borderColor: gruppenSeriesColors[{{ loop.index0 }} % gruppenSeriesColors.length],
            backgroundColor: gruppenSeriesColors[{{ loop.index0 }} % gruppenSeriesColors.length],
            borderWidth: {{ 3 if loop.first else 1.5 }},
            pointRadius: 0,
            tension: 0.15,
          },
          {% endfor %}
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: true, labels: { color: colors.text } }, title: { display: true, text: '', color: colors.text } },
        scales: {
          x: commonScales.x,
          y: { ...commonScales.y, min: 0, max: {{ gruppe.chart_max }} * 1.05 },
        },
      },
    });
    gruppenChart{{ loop.index }}.__baseDatasetCount = {{ gruppe.mitglieder|length }};
    gruppenChart{{ loop.index }}.__benchmarks = {{ gruppe.benchmarks_json | safe }};
    benchmarkCharts.push(gruppenChart{{ loop.index }});
    // #91: dieser Chart hat keinen Zeitraum-Umschalter - der Schalter im
    // Drei-Punkt-Menue tauscht deshalb Reihen, Skala und Benchmark direkt aus.
    {
      const eigen = {
        labels: gruppenChart{{ loop.index }}.data.labels,
        reihen: gruppenChart{{ loop.index }}.data.datasets.map((d) => d.data),
        chart_max: {{ gruppe.chart_max }},
        benchmarks: gruppenChart{{ loop.index }}.__benchmarks,
      };
      const erweitertDaten = {{ gruppe.erweitert_json | safe }};
      if (erweitertDaten) {
        window.__erweitertRefresh.push(function (erweitert) {
          const q = erweitert ? erweitertDaten : eigen;
          gruppenChart{{ loop.index }}.data.labels = q.labels;
          q.reihen.forEach((reihe, i) => { gruppenChart{{ loop.index }}.data.datasets[i].data = reihe; });
          gruppenChart{{ loop.index }}.options.scales.y.max = q.chart_max * 1.05;
          gruppenChart{{ loop.index }}.__benchmarks = q.benchmarks;
          applyBenchmarkDataset(gruppenChart{{ loop.index }});
        });
      }
    }
    chartRefreshers.push(function () {
      gruppenChart{{ loop.index }}.options.plugins.title.text = T('Wertverlauf im Vergleich', 'Value history compared');
      gruppenChart{{ loop.index }}.update();
    });
    chartRefreshers[chartRefreshers.length - 1]();
  }
  {% endfor %}

  // Zeitraum-Presets (#54, Variante B): jeder Preset ist bereits fertig aus einer
  // eigenen engine.simulate()-Neu-Simulation (frisches Startkapital, siehe
  // dashboard._zeitraum_presets()) - der Umschalter hier wechselt nur, welcher
  // bereits vorhandene Datensatz im Chart angezeigt wird, ohne neu zu rechnen.
  function initZeitraumSwitch(chart, switchEl, presets, defaultMax) {
    if (!switchEl) return;
    const byId = Object.fromEntries(presets.map((p) => [p.id, p]));
    const renditeEl = switchEl.querySelector('.zeitraum-rendite');
    let currentPreset = null;
    const setRenditeText = () => {
      if (renditeEl && currentPreset) {
        renditeEl.textContent = `${T('Rendite im Zeitraum', 'Return over the period')}: ${currentPreset.rendite_label}%`;
      }
    };
    const apply = (id) => {
      const preset = byId[id];
      if (!preset) return;
      currentPreset = preset;
      chart.data.labels = preset.labels;
      chart.data.datasets[0].data = preset.total_values;
      chart.options.scales.y.max = (preset.chart_max || defaultMax) * 1.05;
      chart.__benchmarks = preset.benchmarks || [];
      applyBenchmarkDataset(chart);
      setRenditeText();
      switchEl.querySelectorAll('button').forEach((btn) => btn.classList.toggle('active', btn.dataset.preset === id));
    };
    switchEl.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.preset));
    });
    apply('alle');
    chartRefreshers.push(setRenditeText);
    // #91: der Schalter im Drei-Punkt-Menue waehlt den bereits vorberechneten
    // "Erweitert"-Preset (#80), wo es ihn gibt - Charts ohne zusaetzliche
    // Historie bleiben auf "Gesamte Historie".
    window.__erweitertRefresh.push(function (erweitert) {
      apply(erweitert && byId['erweitert'] ? 'erweitert' : 'alle');
    });
  }

  {% for s in strategies %}
  {
    // #64-Folgearbeit: Strategien mit eigener Chart-Skala (z. B. der SP500-Benchmark,
    // dessen Endwert ein Vielfaches der uebrigen betraegt) nutzen ihr eigenes Maximum
    // statt des gemeinsamen wertChartMax - sonst wuerden alle anderen Charts auf der
    // Startseite durch sie flachgedrueckt.
    const eigeneSkala = {{ 'true' if s.eigene_chart_skala else 'false' }};
    const strategieMax = eigeneSkala ? {{ s.own_chart_max | tojson }} : wertChartMax;
    const chart = new Chart(document.getElementById('value-chart-{{ loop.index }}'), {
      type: 'line',
      data: {
        labels: {{ s.labels_json | safe }},
        datasets: [{
          label: 'Gesamtwert (€)',
          data: {{ s.total_values_json | safe }},
          borderColor: colors.series1,
          backgroundColor: colors.series1,
          borderWidth: 2,
          pointRadius: 0,
          tension: 0.15,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: true, labels: { color: colors.text } }, title: { display: true, text: '', color: colors.text } },
        // Eigenes scales-Objekt statt der geteilten wertChartScales-Referenz: der
        // Zeitraum-Umschalter unten mutiert scales.y.max je Chart-Instanz, ein
        // geteiltes Objekt wuerde das auf alle Charts gleichzeitig anwenden. Fixes
        // `max` statt `suggestedMax` (#72): die Skala darf sich durch den
        // Benchmark-Schalter nicht veraendern, ein `suggestedMax` waere von Chart.js
        // aber nur als Untergrenze behandelt und durch eine groessere Benchmark-Reihe
        // ueberschritten worden.
        scales: { x: commonScales.x, y: { ...commonScales.y, min: 0, max: strategieMax * 1.05 } },
      },
    });
    chart.__benchmarks = {{ s.benchmarks_json | safe }};
    benchmarkCharts.push(chart);
    chartRefreshers.push(function () {
      chart.options.plugins.title.text = T('Wertverlauf', 'Value history');
      chart.update();
    });
    chartRefreshers[chartRefreshers.length - 1]();
    initZeitraumSwitch(chart, document.getElementById('zeitraum-switch-{{ loop.index }}'), {{ s.zeitraum_presets_json | safe }}, strategieMax);
  }
  {% endfor %}
</script>
{% endblock %}
